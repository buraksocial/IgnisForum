{{define "home"}}
{{template "header" .}}
<div class="home-grid">
  <div>
    {{range .PluginNotices}}<aside class="plugin-notice">{{.}}</aside>{{end}}
    {{if not .Cats}}
      <div class="empty">{{.Locale.Text "home.empty" "--seed"}}</div>
    {{end}}
    {{range .Cats}}
      <section class="cat-block">
        <div class="cat-header">{{.Title}}</div>
        <table class="forum-table"><tbody>
          {{range .Forums}}
          <tr class="forum-row">
            <td><div class="forum-main">
              <div class="forum-icon">▤</div>
              <div>
                <a class="forum-title" href="/f/{{.ID}}">{{.Title}}</a>
                {{if .Description}}<div class="forum-desc">{{.Description}}</div>{{end}}
                <div class="muted" style="font-size:12px;margin-top:4px">{{$.Locale.Text "home.forum_counts" ($.Locale.Count "count.threads" .ThreadCount) ($.Locale.Count "count.posts" .PostCount)}}</div>
              </div>
            </div></td>
            <td class="forum-last">
              {{if .LastPostURL}}
                <a class="lp-title" href="{{.LastPostURL}}">{{.LastPostTitle}}</a>
                <div class="lp-meta">{{.LastPoster}} · {{$.Locale.Ago .LastPostTime $.Now}}</div>
              {{else}}
                <span class="muted">{{$.Locale.Text "home.no_posts"}}</span>
              {{end}}
            </td>
          </tr>
          {{end}}
        </tbody></table>
      </section>
    {{end}}
  </div>
  <aside>
    {{with .Sidebar}}
    {{if .Pinned}}<section class="side-panel widget"><h2 class="sp-title">{{$.Locale.Text "home.pinned"}}</h2><ul>{{range .Pinned}}<li><a href="/t/{{.ID}}">{{.Title}}</a></li>{{end}}</ul></section>{{end}}
    {{if .Statistics}}<section class="side-panel widget"><h2 class="sp-title">{{$.Locale.Text "home.stats"}}</h2><ul><li>{{$.Locale.Text "home.stats_threads"}} <strong>{{.Threads}}</strong></li><li>{{$.Locale.Text "home.stats_posts"}} <strong>{{.Posts}}</strong></li></ul></section>{{end}}
    {{if .Presence}}<section class="side-panel widget"><h2 class="sp-title">{{$.Locale.Text "home.online"}}</h2><ul><li>{{$.Locale.Count "home.online_count" .Online}}</li></ul></section>
    {{if $.Me}}<section class="side-panel widget"><h2 class="sp-title">{{$.Locale.Text "home.active"}}</h2><ul>{{range .Active}}<li><a href="/members/{{.ID}}">{{.Name}}</a></li>{{else}}<li>{{$.Locale.Text "home.no_active"}}</li>{{end}}</ul></section>{{end}}{{end}}
    {{if .AdURL}}<section class="side-panel widget"><h2 class="sp-title">{{$.Locale.Text "home.ad"}}</h2><ul><li><a href="{{.AdURL}}" rel="sponsored nofollow noopener noreferrer" target="_blank">{{.AdTitle}}</a></li></ul></section>{{end}}
    {{end}}
    <div class="side-panel">
      <div class="sp-title">{{.Locale.Text "home.latest"}}</div>
      <ul>
        {{range .LatestThreads}}
        <li><a href="/t/{{.ID}}">{{.Title}}</a>
          <div class="sp-meta">{{.Author}} · {{$.Locale.Ago .Date $.Now}}</div></li>
        {{else}}
        <li class="muted">{{$.Locale.Text "home.no_threads"}}</li>
        {{end}}
      </ul>
    </div>
    <div class="side-panel" style="margin-top:16px">
      <div class="sp-title">{{.Locale.Text "nav.search"}}</div>
      <div style="padding:12px 16px">
        <form method="get" action="/search">
          <input type="search" name="q" placeholder="{{.Locale.Text "search.placeholder"}}">
        </form>
      </div>
    </div>
  </aside>
</div>
{{template "footer" .}}
{{end}}
