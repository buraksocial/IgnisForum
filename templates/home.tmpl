{{define "home"}}
{{template "header" .}}
<div class="home-grid">
  <div>
    {{range .PluginNotices}}<aside class="plugin-notice">{{.}}</aside>{{end}}
    {{if not .Cats}}
      <div class="empty">Henüz forum yok. Sunucuyu <code>--seed</code> ile örnek veriyle başlatabilirsiniz.</div>
    {{end}}
    {{range .Cats}}
      <section class="cat-block">
        <div class="cat-header">{{.Title}}</div>
        <table class="forum-table"><tbody>
          {{range .Forums}}
          <tr class="forum-row">
            <td><div class="forum-main">
              <div class="forum-icon">▤</div>
              <div>
                <a class="forum-title" href="/f/{{.ID}}">{{.Title}}</a>
                {{if .Description}}<div class="forum-desc">{{.Description}}</div>{{end}}
                <div class="muted" style="font-size:12px;margin-top:4px">{{.ThreadCount}} konu · {{.PostCount}} mesaj</div>
              </div>
            </div></td>
            <td class="forum-last">
              {{if .LastPostURL}}
                <a class="lp-title" href="{{.LastPostURL}}">{{.LastPostTitle}}</a>
                <div class="lp-meta">{{.LastPoster}} · {{ago .LastPostTime}}</div>
              {{else}}
                <span class="muted">Henüz mesaj yok</span>
              {{end}}
            </td>
          </tr>
          {{end}}
        </tbody></table>
      </section>
    {{end}}
  </div>
  <aside>
    {{with .Sidebar}}
    {{if .Pinned}}<section class="side-panel widget"><h2 class="sp-title">Sabit Duyurular</h2><ul>{{range .Pinned}}<li><a href="/t/{{.ID}}">{{.Title}}</a></li>{{end}}</ul></section>{{end}}
    {{if .Statistics}}<section class="side-panel widget"><h2 class="sp-title">Forum İstatistikleri</h2><ul><li>Açılan konular <strong>{{.Threads}}</strong></li><li>Yazılan mesajlar <strong>{{.Posts}}</strong></li></ul></section>{{end}}
    {{if .Presence}}<section class="side-panel widget"><h2 class="sp-title">Çevrimiçi Üyeler</h2><ul><li>Son 15 dakikada {{.Online}} üye</li></ul></section>
    {{if $.Me}}<section class="side-panel widget"><h2 class="sp-title">Aktif Üyeler</h2><ul>{{range .Active}}<li><a href="/members/{{.ID}}">{{.Name}}</a></li>{{else}}<li>Son 5 dakikada aktif üye yok.</li>{{end}}</ul></section>{{end}}{{end}}
    {{if .AdURL}}<section class="side-panel widget"><h2 class="sp-title">Reklam</h2><ul><li><a href="{{.AdURL}}" rel="sponsored nofollow noopener noreferrer" target="_blank">{{.AdTitle}}</a></li></ul></section>{{end}}
    {{end}}
    <div class="side-panel">
      <div class="sp-title">Son Konular</div>
      <ul>
        {{range .LatestThreads}}
        <li><a href="/t/{{.ID}}">{{.Title}}</a>
          <div class="sp-meta">{{.Author}} · {{ago .Date}}</div></li>
        {{else}}
        <li class="muted">Henüz konu yok.</li>
        {{end}}
      </ul>
    </div>
    <div class="side-panel" style="margin-top:16px">
      <div class="sp-title">Ara</div>
      <div style="padding:12px 16px">
        <form method="get" action="/search">
          <input type="search" name="q" placeholder="Konu ve mesajlarda ara…">
        </form>
      </div>
    </div>
  </aside>
</div>
{{template "footer" .}}
{{end}}
