{{define "admin_reports"}}
{{template "header" .}}
<div class="toolbar"><h1>Moderasyon raporları</h1><a class="btn" href="/admin">Yönetime dön</a></div>
{{range .Reports}}
<section class="panel report-card">
  <div class="report-meta"><strong>Rapor #{{.ID}}</strong><span class="muted">{{.Reporter}} · {{ago .CreatedAt}}</span></div>
  <p>{{.Reason}}</p>
  <div class="report-actions"><a class="btn" href="/t/{{.ThreadID}}/post/{{.PostID}}">Mesaja git</a>
    <form method="post" action="/admin/reports/{{.ID}}/resolve"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn btn-primary">Çözüldü</button></form>
  </div>
</section>
{{else}}<div class="empty">Açık rapor yok.</div>{{end}}
{{template "footer" .}}
{{end}}
