{{define "thread"}}
{{template "header" .}}
{{$page := .}}
<div class="toolbar">
  <h1>{{.Thread.Title}}</h1>
  <a class="btn" href="/f/{{.Thread.NodeID}}">Foruma dön</a>
  {{if .Me}}<form method="post" action="/t/{{.Thread.ID}}/follow" class="thread-follow-form">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <button class="btn{{if .Following}} btn-primary{{end}}" type="submit">{{if .Following}}Takip ediliyor · Takibi bırak{{else}}Konuyu takip et{{end}}</button>
  </form>{{end}}
</div>
<p class="muted" style="font-size:13px">
  {{.Thread.PostCount}} mesaj · {{.Thread.ViewCount}} görüntülenme
</p>
{{if .Tags}}<div class="tag-list">{{range .Tags}}<a class="tag" href="/tags/{{.Slug}}">{{.Title}}</a>{{end}}</div>{{end}}
{{if .Poll}}<section class="poll panel">
  <h2>{{.Poll.Question}}</h2>
  {{if .Poll.CanVote}}<form method="post" action="/t/{{$.Thread.ID}}/poll/vote">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    {{range .Poll.Options}}<label class="poll-option"><input type="{{if $.Poll.Multiple}}checkbox{{else}}radio{{end}}" name="option" value="{{.Index}}"> {{.Text}}</label>{{end}}
    <button class="btn btn-primary" type="submit">Oy ver</button>
  </form>{{else}}
    {{if and $.Me .Poll.HasVoted}}<p class="muted">Oyunuz kaydedildi.</p>{{else if not $.Me}}<p><a href="/login?next=/t/{{$.Thread.ID}}">Oy vermek için giriş yapın.</a></p>{{end}}
    {{range .Poll.Options}}<div class="poll-result">{{.Text}} <strong>{{.Votes}}</strong>{{if .Selected}} · Seçiminiz{{end}}</div>{{end}}
  {{end}}
</section>{{end}}
{{range .Posts}}
{{$post := .}}
<article class="post-block" id="post-{{.ID}}">
  <div class="post-head">
    <div class="post-avatar">{{if .AvatarURL}}<img src="{{.AvatarURL}}" alt="{{.Author}}" loading="lazy">{{else}}{{first .Author}}{{end}}</div>
    <div class="post-who">
      <a class="post-username" href="/members/{{.UserID}}">{{.Author}}</a>
      <div class="post-rank">{{.Rank}}</div>
    </div>
    <div class="post-num">#{{.Number}} · {{ago .Date}}</div>
  </div>
  <div class="post-body">{{.Rendered}}</div>
  {{if or .Attachment .CanAttach}}<div class="post-attachment">
    {{if .Attachment}}<p><a href="/t/{{$page.Thread.ID}}/post/{{.ID}}/attachment" download>{{$.Locale.Text "attachment.download" .Attachment.Name}}</a> ({{.Attachment.Size}} B)</p>{{end}}
    {{if .CanAttach}}{{if .Attachment}}
    <form method="post" action="/t/{{$page.Thread.ID}}/post/{{.ID}}/attachment/remove">
      <input type="hidden" name="csrf" value="{{$.CSRF}}"><button type="submit" class="btn">{{$.Locale.Text "attachment.remove"}}</button>
    </form>
    {{else}}<details><summary>{{$.Locale.Text "attachment.add"}}</summary>
      <form method="post" enctype="multipart/form-data" action="/t/{{$page.Thread.ID}}/post/{{.ID}}/attachment">
        <input type="hidden" name="csrf" value="{{$.CSRF}}">
        <label>{{$.Locale.Text "attachment.file"}} <input type="file" name="attachment" required></label>
        <button type="submit" class="btn">{{$.Locale.Text "attachment.upload"}}</button>
      </form>
    </details>{{end}}{{end}}
  </div>{{end}}
   {{if .Media}}<ul class="post-media">{{range .Media}}<li>{{if eq .Kind "img"}}<a href="{{.Preview}}">{{$.Locale.Text "media.preview"}}</a> ({{.Host}}){{else}}<a href="{{.URL}}" rel="ugc nofollow noopener noreferrer" target="_blank">{{if eq .Kind "download"}}{{$.Locale.Text "media.download"}}{{else}}{{$.Locale.Text "media.open"}}{{end}}</a> ({{.Host}}){{end}}</li>{{end}}</ul>{{end}}
  <div class="post-foot">
    {{if .Edited}}<span class="muted">Son düzenleme: {{.Author}} · {{ago .Date}}</span>{{end}}
    <a href="#post-{{.ID}}" title="Kalıcı bağlantı">#{{.Number}}</a>
    {{if $page.CanReply}}<a href="/t/{{$page.Thread.ID}}?quote={{.ID}}#reply">Alıntıla</a>{{end}}
    {{if .CanEdit}}<details class="post-edit"><summary>Düzenle</summary>
      <form method="post" action="/t/{{$page.Thread.ID}}/post/{{.ID}}/edit">
        <input type="hidden" name="csrf" value="{{$page.CSRF}}">
        <textarea name="message" rows="5" maxlength="20000" required>{{.Raw}}</textarea>
        <button class="btn btn-primary" type="submit">Değişiklikleri kaydet</button>
      </form>
    </details>{{end}}
    {{if .CanDelete}}<details class="post-delete"><summary>Sil</summary>
      <form method="post" action="/t/{{$page.Thread.ID}}/post/{{.ID}}/delete">
        <input type="hidden" name="csrf" value="{{$page.CSRF}}">
        <button class="btn" type="submit">Bu yanıtı sil</button>
      </form>
    </details>{{end}}
    {{if .CanReport}}<details class="post-report"><summary>Raporla</summary>
      <form method="post" action="/t/{{$page.Thread.ID}}/post/{{.ID}}/report">
        <input type="hidden" name="csrf" value="{{$page.CSRF}}">
        <label>Gerekçe<textarea name="reason" rows="2" maxlength="500" minlength="3" required></textarea></label>
        <button class="btn" type="submit">Moderatörlere gönder</button>
      </form>
    </details>{{end}}
  </div>
  <div class="reaction-row" aria-label="Mesaj tepkileri">
    {{range .Reactions}}
      {{if $.Me}}
      <form method="post" action="/t/{{$page.Thread.ID}}/post/{{$post.ID}}/reaction" style="display:inline">
        <input type="hidden" name="csrf" value="{{$page.CSRF}}">
        <input type="hidden" name="reaction" value="{{.Type}}">
        <button class="reaction-button{{if .Selected}} selected{{end}}" type="submit" aria-pressed="{{.Selected}}">{{.Label}} <span>{{.Count}}</span></button>
      </form>
      {{else if gt .Count 0}}
      <span class="reaction-button">{{.Label}} <span>{{.Count}}</span></span>
      {{end}}
    {{end}}
  </div>
</article>
{{else}}
<div class="empty">Bu konuda henüz mesaj yok.</div>
{{end}}
{{template "pager" .}}
{{if .CanReply}}
<form class="reply-box" id="reply" method="post" action="/t/{{.Thread.ID}}/reply">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <label>Hızlı Yanıt</label>
  <textarea name="message" rows="5" required placeholder="Cevabınızı yazın… ([b]kalın[/b], [quote]alıntı[/quote], [code]kod[/code])">{{.ReplyDraft}}</textarea>
  <div style="margin-top:10px"><button type="submit" class="btn btn-primary">Yanıtla</button></div>
</form>
{{else if not .Me}}
<div class="reply-box muted">Yanıt yazmak için <a href="/login?next=/t/{{.Thread.ID}}">giriş yapın</a>.</div>
{{end}}
{{template "footer" .}}
{{end}}

{{define "newthread"}}
{{template "header" .}}
<h1>Yeni Konu — {{.Node.Title}}</h1>
<form method="post" action="/f/{{.Node.ID}}/new" style="max-width:720px">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <div class="form-row"><label>Başlık</label><input type="text" name="title" required maxlength="160" placeholder="Konu başlığı"></div>
  <div class="form-row"><label>Mesaj</label><textarea name="message" rows="8" required placeholder="[b]kalın[/b], [url=https://example.com]bağlantı[/url], [code]kod[/code] desteklenir"></textarea></div>
  <div class="form-row"><label>Etiketler <small>(virgülle ayırın, en fazla 5)</small></label><input type="text" name="tags" maxlength="200" placeholder="go, performans, soru"></div>
  {{if .Node.Options.AllowPolls}}<fieldset class="form-row"><legend>Anket (isteğe bağlı)</legend>
    <label>Soru<input type="text" name="poll_question" maxlength="150"></label>
    <label>Seçenekler <small>(her satıra bir seçenek, 2-10)</small><textarea name="poll_options" rows="5" maxlength="1200"></textarea></label>
    <label><input type="checkbox" name="poll_multiple" value="1"> Birden fazla seçenek işaretlenebilsin</label>
  </fieldset>{{end}}
  <div class="form-row"><button type="submit" class="btn btn-primary">Konuyu Aç</button> <a class="btn" href="/f/{{.Node.ID}}">İptal</a></div>
</form>
{{template "footer" .}}
{{end}}
