{{define "notifications"}}
{{template "header" .}}
<div class="toolbar"><h1>{{.Locale.Text "nav.notifications"}}</h1><span>{{.Locale.Text "notifications.unread" .UnreadNotifications}}</span></div>
{{if .Notifications}}
<section class="notification-list">
  {{range .Notifications}}<article class="notification{{if not .Read}} unread{{end}}">
    <div><a href="/t/{{.ThreadID}}">{{$.Locale.Text "notifications.reply" .Actor .ThreadTitle}}</a><time>{{$.Locale.Ago .CreatedAt $.Now}}</time></div>
    {{if not .Read}}<form method="post" action="/notifications/{{.ID}}/read"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn" type="submit">{{$.Locale.Text "notifications.mark_read"}}</button></form>{{end}}
  </article>{{end}}
</section>
{{else}}<p class="empty">{{.Locale.Text "notifications.empty"}}</p>{{end}}
{{template "footer" .}}
{{end}}
