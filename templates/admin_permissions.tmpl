{{define "admin_permissions"}}
{{template "header" .}}
<div class="toolbar"><h1>İzin matrisi</h1><a class="btn" href="/admin">Yönetime dön</a></div>
<form class="panel admin-filter" method="get" action="/admin/permissions">
  <label for="scope">Kapsam</label>
  <select id="scope" name="scope">
    <option value="*" {{if eq .AdminScope "*"}}selected{{end}}>Genel</option>
    <option value="node" {{if eq .AdminScope "node"}}selected{{end}}>Kategori / forum</option>
  </select>
  <label for="node">Düğüm</label>
  <select id="node" name="node">
    {{range .AdminNodes}}<option value="{{.ID}}" {{if eq .ID $.AdminNodeID}}selected{{end}}>{{.Type}} · {{.Title}}</option>{{end}}
  </select>
  <button class="btn" type="submit">Kapsamı aç</button>
</form>
<form method="post" action="/admin/permissions">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="scope" value="{{.AdminScope}}">
  {{if eq .AdminScope "node"}}<input type="hidden" name="node" value="{{.AdminNodeID}}">{{end}}
  <div class="table-wrap">
    <table class="data-table permission-table">
      <thead><tr><th>İzin</th>{{range .AdminGroups}}<th>{{.Name}}</th>{{end}}</tr></thead>
      <tbody>
      {{range .AdminPermissionRows}}
        <tr><th scope="row">{{.Label}}<small>{{.Key}}</small></th>
        {{range .Cells}}<td>
          <select name="{{.Name}}" aria-label="{{.Name}}">
            <option value="inherit" {{if eq .Value "inherit"}}selected{{end}}>Devral</option>
            <option value="allow" {{if eq .Value "allow"}}selected{{end}}>İzin ver</option>
            <option value="deny" {{if eq .Value "deny"}}selected{{end}}>Reddet</option>
          </select>
        </td>{{end}}</tr>
      {{end}}
      </tbody>
    </table>
  </div>
  <div class="admin-actions"><button class="btn btn-primary" type="submit">İzinleri kaydet</button></div>
</form>
{{template "footer" .}}
{{end}}
