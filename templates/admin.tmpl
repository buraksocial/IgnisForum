{{define "admin"}}
{{template "header" .}}
<div class="toolbar"><h1>Yönetim merkezi</h1></div>
<div class="admin-grid">
  <section class="panel"><h2>Görünüm ve eklentiler</h2><a class="btn btn-primary" href="/admin/appearance">Temaları ve eklentileri yönet</a></section>
  <section class="panel">
    <h2>Forum yapısı</h2>
    <p class="muted">Kategori ve forumları ekleyin, düzenleyin veya boş düğümleri kaldırın.</p>
    <a class="btn btn-primary" href="/admin/nodes">Forumları yönet</a>
  </section>
  <section class="panel">
    <h2>Rapor kuyruğu</h2>
    <p class="muted">Üyelerin bildirdiği mesajları inceleyin ve sonuçlandırın.</p>
    <a class="btn btn-primary" href="/admin/reports">Raporları incele</a>
  </section>
  <section class="panel">
    <h2>İzinler</h2>
    <p class="muted">Misafir, üye ve yönetici grupları için genel veya forum bazlı erişimleri yönetin.</p>
    <a class="btn btn-primary" href="/admin/permissions">İzin matrisini aç</a>
  </section>
  <section class="panel">
    <h2>Güvenlik</h2>
    <p>Yönetim değişiklikleri oturum, CSRF doğrulaması ve işlem sınırıyla korunur.</p>
  </section>
</div>
{{template "footer" .}}
{{end}}
