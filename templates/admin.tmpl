{{define "admin"}}
{{template "header" .}}
<div class="toolbar"><h1>{{.Locale.Text "admin.home"}}</h1></div>
<div class="admin-grid">
  <section class="panel"><h2>{{.Locale.Text "admin.appearance"}}</h2><a class="btn btn-primary" href="/admin/appearance">{{.Locale.Text "admin.manage_appearance"}}</a></section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.structure"}}</h2>
    <p class="muted">{{.Locale.Text "admin.structure_help"}}</p>
    <a class="btn btn-primary" href="/admin/nodes">{{.Locale.Text "admin.manage_nodes"}}</a>
  </section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.queue"}}</h2>
    <p class="muted">{{.Locale.Text "admin.queue_help"}}</p>
    <a class="btn btn-primary" href="/admin/reports">{{.Locale.Text "admin.review"}}</a>
  </section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.permissions"}}</h2>
    <p class="muted">{{.Locale.Text "admin.permissions_help"}}</p>
    <a class="btn btn-primary" href="/admin/permissions">{{.Locale.Text "admin.open_matrix"}}</a>
  </section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.users"}}</h2>
    <p class="muted">{{.Locale.Text "admin.users_help"}}</p>
    <a class="btn btn-primary" href="/admin/users">{{.Locale.Text "admin.manage_users"}}</a>
  </section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.security"}}</h2>
    <p>{{.Locale.Text "admin.security_help"}}</p>
  </section>
  <section class="panel">
    <h2>{{.Locale.Text "admin.audit"}}</h2>
    <p class="muted">{{.Locale.Text "admin.audit_help"}}</p>
    <a class="btn btn-primary" href="/admin/audit">{{.Locale.Text "admin.audit_open"}}</a>
  </section>
</div>
{{template "footer" .}}
{{end}}
