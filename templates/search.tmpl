{{define "search"}}
{{template "header" .}}
<h1>Arama</h1>
<form method="get" action="/search" style="max-width:560px;margin-bottom:24px">
  <div class="form-row"><input type="search" name="q" value="{{.Query}}" placeholder="Konu ve mesajlarda ara…" autofocus></div>
  <button type="submit" class="btn btn-primary">Ara</button>
</form>
{{if .HaveQ}}
{{if .Hits}}
<table class="thread-table"><tbody>
  {{range .Hits}}
  <tr class="thread-row"><td>
    <a class="thread-title" href="/t/{{.ID}}">{{.Title}}</a>
    <div class="thread-by">{{.Author}} · {{.ReplyCount}} yanıt · {{ago .Date}}</div>
  </td></tr>
  {{end}}
</tbody></table>
{{else}}
<div class="empty">«{{.Query}}» için sonuç bulunamadı.</div>
{{end}}
{{end}}
{{template "footer" .}}
{{end}}

{{define "notfound"}}
{{template "header" .}}
<div class="empty"><h1>404 — Bulunamadı</h1>
<p>Aradığınız içerik kaldırılmış ya da hiç var olmamış olabilir.</p>
<p><a class="btn" href="/">Ana sayfaya dön</a></p></div>
{{template "footer" .}}
{{end}}
