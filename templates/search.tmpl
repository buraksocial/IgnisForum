{{define "search"}}
{{template "header" .}}
<h1>{{.Locale.Text "search.title"}}</h1>
<form method="get" action="/search" style="max-width:560px;margin-bottom:24px">
  <div class="form-row"><input type="search" name="q" aria-label="{{.Locale.Text "search.title"}}" value="{{.Query}}" placeholder="{{.Locale.Text "search.placeholder"}}" autofocus></div>
  <button type="submit" class="btn btn-primary">{{.Locale.Text "nav.search"}}</button>
</form>
{{if .HaveQ}}
{{if .Hits}}
<table class="thread-table"><tbody>
  {{range .Hits}}
  <tr class="thread-row"><td>
    <a class="thread-title" href="/t/{{.ID}}">{{.Title}}</a>
    <div class="thread-by">{{.Author}} · {{$.Locale.Count "count.replies" .ReplyCount}} · {{$.Locale.Ago .Date $.Now}}</div>
  </td></tr>
  {{end}}
</tbody></table>
{{else}}
<div class="empty">{{.Locale.Text "search.empty" .Query}}</div>
{{end}}
{{end}}
{{template "footer" .}}
{{end}}

{{define "notfound"}}
{{template "header" .}}
<div class="empty"><h1>{{.Locale.Text "notfound.heading"}}</h1>
<p>{{.Locale.Text "notfound.body"}}</p>
<p><a class="btn" href="/">{{.Locale.Text "notfound.back"}}</a></p></div>
{{template "footer" .}}
{{end}}
